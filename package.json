{
  "name": "photoselect-desktop",
  "version": "1.1.0",
  "description": "极速摄影选片与管理桌面应用 - Zero-Import, Millisecond-level RAW+JPG Culling Platform",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "build:msix": "powershell -ExecutionPolicy Bypass -File ./build-msix.ps1",
    "build:msix:quick": "powershell -ExecutionPolicy Bypass -File ./build-msix.ps1 -SkipBuild",
    "build:msix:store": "powershell -ExecutionPolicy Bypass -File ./build-msix.ps1 -StoreReady",
    "build:linux": "wsl -d Ubuntu bash ./build-linux.sh"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.1",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "lucide-vue-next": "^0.454.0",
    "pinia": "^2.2.4",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.8.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.8"
  }
}
