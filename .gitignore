*.iml
*.iws
*.ipr

# Visual Studio (MSVC)
.vs/
*.suo
*.user
*.userosv
*.sln.docstates

# Sublime Text
*.sublime-project
*.sublime-workspace

# AI & Modern Editors
.cursor/
.claude/
.zed/

